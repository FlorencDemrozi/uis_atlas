# UiS Researcher Atlas: the weekly update (installed by deploy/install.sh, which fills
# in the @...@ values). Started by atlas-weekly.timer; by hand:
#   sudo systemctl start atlas-weekly.service
[Unit]
Description=UiS Researcher Atlas weekly update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
# Collect, process and build web/dist (pipeline/run_weekly.py; log in @REPO@/logs/).
ExecStart=@VENV@/bin/python pipeline/run_weekly.py
# Only after a successful run: copy the new site to the folder nginx serves. A failed
# run leaves the published site as it was.
ExecStartPost=/usr/bin/rsync -a --delete @REPO@/web/dist/ @WEBROOT@/
TimeoutStartSec=12h
Nice=10
# Hardening: the job may write only its own folder, its caches and the web folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@REPO@ @HOME@/.cache @HOME@/.npm @WEBROOT@
