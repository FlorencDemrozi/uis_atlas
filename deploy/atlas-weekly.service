# UiS Atlas weekly update: a systemd *user* service, installed by deploy/setup.sh into
# ~/.config/systemd/user/ (it fills in @REPO@ and @VENV@). Started by atlas-weekly.timer;
# by hand: systemctl --user start --no-block atlas-weekly.service
# Node.js comes from nvm, which only a login shell loads, so it is sourced first.
[Unit]
Description=UiS Researcher Atlas weekly update

[Service]
Type=oneshot
WorkingDirectory=@REPO@
# The nginx container reads the site as another user.
UMask=0022
TimeoutStartSec=12h
Nice=10
ExecStart=/bin/bash -c '. "$HOME/.nvm/nvm.sh" && exec "@VENV@/bin/python" pipeline/run_weekly.py'
# Only after a successful run: copy web/dist to the folder nginx serves. A failed run
# (collector, processing or build) leaves the published site as it was.
ExecStartPost=@REPO@/deploy/publish.sh
