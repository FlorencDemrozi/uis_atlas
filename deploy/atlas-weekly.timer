# UiS Atlas: run the weekly update every Saturday at 01:00 (server time); a run missed
# while the server was off starts at the next boot. Installed by deploy/setup.sh into
# ~/.config/systemd/user/ (needs "loginctl enable-linger" so it runs without a login).
[Unit]
Description=UiS Researcher Atlas weekly update (Saturdays 01:00)

[Timer]
OnCalendar=Sat *-*-* 01:00:00
Persistent=true
Unit=atlas-weekly.service

[Install]
WantedBy=timers.target
