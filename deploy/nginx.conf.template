# UiS Atlas nginx site. deploy/setup.sh fills in @PORT@, @CERT_NAME@ and
# @CSP_SCRIPT_HASHES@ (the hash of the inline theme script in index.html, computed
# from the published site, so a changed script never blanks the page) and writes the
# result to ~/atlas/deploy/nginx.conf. Edit this template, not the generated file.
#
# Public address: https://atlas.ux.uis.no, a UiS IT reverse proxy (caddy.ux.uis.no) that
# holds the public certificate and forwards to this port.
server {
    listen @PORT@ ssl default_server;
    listen [::]:@PORT@ ssl default_server;
    server_name _;

    root /srv/site;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/@CERT_NAME@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@CERT_NAME@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    gzip on;
    gzip_types application/json application/javascript application/wasm text/css image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Idea and team search (transformers.js): the model (/models/) and the ONNX runtime
    # (/ort/) are served from this site (web/scripts/fetch-model.mjs), so no other host
    # is allowed: the visitor's browser contacts nobody else (privacy page). WebAssembly
    # and blob: workers are still needed.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' @CSP_SCRIPT_HASHES@ 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'" always;

    # Hash routing: everything is a real file, so no SPA fallback is needed.
    location / {
        try_files $uri $uri/ =404;
    }

    # Caching via `expires` (not add_header, which would drop the headers above).
    # Vite's hashed bundles never change.
    location /assets/ {
        expires 1y;
    }

    # The ONNX runtime's JavaScript module (.mjs) is missing from nginx's mime.types; as
    # application/octet-stream, with nosniff, the browser refuses to import it ("no
    # available backend found"). Must come before the next location (first regex wins).
    location ~ ^/ort/.*\.mjs$ {
        types { }
        default_type text/javascript;
        expires 30d;
    }

    # Language model and ONNX runtime: large, rarely changed (the browser also keeps
    # the model in its own cache).
    location ~ ^/(models|ort)/ {
        expires 30d;
    }

    # Data and index.html change with every update: always revalidate.
    location ~ ^/(data/|index\.html$|$) {
        expires -1;
        try_files $uri $uri/ =404;
    }
}
