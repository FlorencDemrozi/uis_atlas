# Copy to .env and fill in. .env is gitignored – never commit real keys.
SCOPUS_API_KEY=
# Optional: lets the collector run off-campus (request via the UiS Library / Elsevier)
SCOPUS_INSTTOKEN=
# Used offline by pipeline/summarize.py (researcher overviews) and
# pipeline/profile_calls.py (scientific profiles of funding calls)
ANTHROPIC_API_KEY=
# Password for the funding pages; pipeline/export_funding.py encrypts the funding
# data with it. Share it only with people who should see those pages. The encrypted
# files are public (and stay in git history), so use a long random passphrase
# (e.g. 5+ random words); a changed password does not protect files already pushed.
ATLAS_FUNDING_PASSWORD=
# First publication year to include (2020 if left out; changing it re-collects
# everything, docs/DEPLOY.md "Maintenance"). Use the same value on laptop and server.
ATLAS_FIRST_YEAR=2000
# Optional: Telegram message after each weekly run (pipeline/notify.py, docs/DEPLOY.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
